{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS, Apple Silicon (bbcpu translates the game's code)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BB_ARCH": "arm64"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS, Apple Silicon, no optimization",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64-asan",
      "displayName": "macOS, Apple Silicon, with the address and undefined sanitizers",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-arm64-asan",
      "cacheVariables": {
        "BB_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS, Rosetta 2 (the game's code runs as it is)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macos-x86_64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "BB_ARCH": "x86_64"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (shell.nix provides the libraries; CI only)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux"
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-asan",
      "configurePreset": "macos-arm64-asan"
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-asan",
      "configurePreset": "macos-arm64-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x86_64",
      "configurePreset": "macos-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
