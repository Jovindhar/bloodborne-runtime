# The dependency build (deps/) is the manifest and its steps; the libraries they install are not
# tracked. /deps/* and not /deps: a directory that is ignored outright is never searched again.
/deps/*
!/deps/CMakeLists.txt
!/deps/packages.cmake
!/deps/steps/
/build

# Editors and macOS
.vscode/
.DS_Store

# The launcher's app icons (tracked despite *.png above)
!launcher/app/src-tauri/icons/*.png
# README screenshots
!docs/screenshots/*.png

# AMD FidelityFX DLLs (FSR 4.1.1 is built from the user's own): never in the repository
*.dll
/private/
