diff --git a/bbport/gpu/bbcoop/memory.cpp b/bbport/gpu/bbcoop/memory.cpp
index eb1a173ac..b0187024a 100644
--- a/bbport/gpu/bbcoop/memory.cpp
+++ b/bbport/gpu/bbcoop/memory.cpp
@@ -11,6 +11,9 @@
 #include <vector>
 #ifdef _WIN32
 #include <windows.h>
+#elif defined(__APPLE__)
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
 #else
 #include <fstream>
 #include <sstream>
@@ -83,6 +86,40 @@ bool HostRegion(uintptr_t address, Region& found) {
     found = {start, start + info.RegionSize, prot};
     return true;
 }
+#elif defined(__APPLE__)
+// BloodOnline (macOS): the host's protection from the kernel's region list (no /proc here).
+bool HostRegion(uintptr_t address, Region& found) {
+    mach_vm_address_t region = address;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info{};
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    if (mach_vm_region(mach_task_self(), &region, &size, VM_REGION_BASIC_INFO_64,
+                       reinterpret_cast<vm_region_info_t>(&info), &count, &object) != KERN_SUCCESS ||
+        region > address) {
+        return false;
+    }
+    const u32 prot = ((info.protection & VM_PROT_READ) ? Read : 0) |
+                     ((info.protection & VM_PROT_WRITE) ? Write : 0) |
+                     ((info.protection & VM_PROT_EXECUTE) ? Execute : 0);
+    if (prot == 0) {
+        return false;
+    }
+    // A region can say it is readable and still fault (a GPU or purgeable mapping, a file mapped
+    // past its end: SIGBUS, which crashed a party's game on a stale enemy pointer). The kernel reads
+    // the byte instead, and reports an error where the game would fault; only that page is given.
+    u8 byte = 0;
+    mach_vm_size_t got = 0;
+    if (mach_vm_read_overwrite(mach_task_self(), address, 1,
+                               reinterpret_cast<mach_vm_address_t>(&byte), &got) != KERN_SUCCESS ||
+        got != 1) {
+        return false;
+    }
+    const uintptr_t page = address & ~static_cast<uintptr_t>(vm_page_size - 1);
+    found = {std::max<uintptr_t>(page, region),
+             std::min<uintptr_t>(page + vm_page_size, region + size), prot};
+    return true;
+}
 #else
 // /proc/self/maps, read again when an address is not in it or it is older than a moment: the
 // co-op code asks about stack words in bursts (a call chain), one region after another.
diff --git a/bbport/gpu/shadps4/common/thread.cpp b/bbport/gpu/shadps4/common/thread.cpp
index c26cc26d7..fa3cafa4a 100644
--- a/bbport/gpu/shadps4/common/thread.cpp
+++ b/bbport/gpu/shadps4/common/thread.cpp
@@ -254,7 +254,11 @@ void PreciseSleepUntil(std::chrono::steady_clock::time_point deadline) {
 #endif
     }
     while (steady_clock::now() < deadline) {
+#if defined(__x86_64__) || defined(_M_X64)
         __builtin_ia32_pause();
+#elif defined(__aarch64__)
+        __builtin_arm_yield(); // BloodOnline: Apple Silicon's spin-wait hint
+#endif
     }
 }
 
